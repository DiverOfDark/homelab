{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.yml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.yml$/"
    ]
  },
  "packageRules": [
    {
      "groupName": "kubernetes",
      "groupSlug": "kubernetes",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.k8s.io/kube-scheduler**",
        "registry.k8s.io/kube-proxy**",
        "registry.k8s.io/kube-controller-manager**",
        "registry.k8s.io/kube-apiserver**"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "actual-server must never outrun jhonderson/actual-http-api (which bundles @actual-app/api and syncs against the server's schema). The server's tag is driven by the actualbudget-lockstep customManager below, keyed to the API image's release feed, so both bump together in one PR. Disable the direct dep so the generic image manager doesn't propose the server independently.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "actualbudget/actual-server"
      ],
      "enabled": false
    },
    {
      "description": "Emby: odd minor versions (4.9, 4.11, ...) are beta builds; stay on stable even minors.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "emby/embyserver"
      ],
      "allowedVersions": "/^\\d+\\.\\d*[02468]\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Ceph: x.0/x.1 releases are dev/RC; only offer stable x.2.z.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/ceph/ceph"
      ],
      "allowedVersions": "/^v\\d+\\.2\\.\\d+$/"
    },
    {
      "description": "CNPG ClusterImageCatalog entries are digest-pinned per PG major; the regex manager only bumps the tag (not the digest), producing misleading PRs. Clusters set imageName directly.",
      "matchFileNames": [
        "k3s-apps/cnpg-postgres-operator.yaml"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/cloudnative-pg/postgis"
      ],
      "enabled": false
    },
    {
      "description": "cloudflare provider 5.26.0+ breaks apply: modified_on 'inconsistent result' (cloudflare/terraform-provider-cloudflare#7387) and include_shadow_metadata PUT rejected on Email Routing records (#7396). Lift once both are fixed.",
      "matchDatasources": [
        "terraform-provider"
      ],
      "matchPackageNames": [
        "cloudflare/cloudflare"
      ],
      "allowedVersions": "<5.26.0"
    }
  ],
  "customManagers": [
    {
      "description": "actualbudget-lockstep: resolve an `image:` tag against a different image's release feed. Used to peg actualbudget/actual-server to the tags jhonderson/actual-http-api actually publishes, so the server can never be ahead of the API client's bundled schema.",
      "customType": "regex",
      "versioningTemplate": "docker",
      "managerFilePatterns": [
        "/(^|/).*\\.y[a]?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+-?\\s*image:\\s*[\"']?[^:\\s\"']+:(?<currentValue>[\\w+\\.\\-]+)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/(^|/).*\\.y[a]?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate: image=(?<depName>.*?)\\s+[\\w]*[vV]ersion:\\s*[\"']?(?<currentValue>[\\w+\\.\\-]*)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/(^|/).*\\.y[a]?ml$/"
      ],
      "matchStrings": [
        "image: [\"']?(?<depName>.*?):(?<currentValue>[\\w+\\.\\-]*)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/).*\\.y[a]?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+(?:version|tag):\\s*[\"']?(?<currentValue>[\\w+\\.\\-]*)"
      ]
    }
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "automerge": false,
  "automergeType": "pr",
  "labels": [
    "automerge"
  ]
}
