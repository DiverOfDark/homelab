{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.yml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.yml$/"
    ]
  },
  "packageRules": [
    {
      "groupName": "kubernetes",
      "groupSlug": "kubernetes",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.k8s.io/kube-scheduler**",
        "registry.k8s.io/kube-proxy**",
        "registry.k8s.io/kube-controller-manager**",
        "registry.k8s.io/kube-apiserver**"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "actual-server must never outrun jhonderson/actual-http-api (which bundles @actual-app/api and syncs against the server's schema). The server's tag is driven by the actualbudget-lockstep customManager below, keyed to the API image's release feed, so both bump together in one PR. Disable the direct dep so the generic image manager doesn't propose the server independently.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "actualbudget/actual-server"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "description": "actualbudget-lockstep: resolve an `image:` tag against a different image's release feed. Used to peg actualbudget/actual-server to the tags jhonderson/actual-http-api actually publishes, so the server can never be ahead of the API client's bundled schema.",
      "customType": "regex",
      "versioningTemplate": "docker",
      "managerFilePatterns": [
        "/(^|/).*\\.y[a]?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+-?\\s*image:\\s*[\"']?[^:\\s\"']+:(?<currentValue>[\\w+\\.\\-]+)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/(^|/).*\\.y[a]?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate: image=(?<depName>.*?)\\s+[\\w]*[vV]ersion:\\s*[\"']?(?<currentValue>[\\w+\\.\\-]*)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/(^|/).*\\.y[a]?ml$/"
      ],
      "matchStrings": [
        "image: [\"']?(?<depName>.*?):(?<currentValue>[\\w+\\.\\-]*)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/).*\\.y[a]?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+(?:version|tag):\\s*[\"']?(?<currentValue>[\\w+\\.\\-]*)"
      ]
    }
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "automerge": false,
  "automergeType": "pr",
  "labels": [
    "automerge"
  ]
}
